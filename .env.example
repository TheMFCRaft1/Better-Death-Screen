# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird von Git ignoriert — niemals committen.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Publishing aktivieren (Pflicht für upload-Tasks)
# ---------------------------------------------------------------------------
PUBLISH_ENABLED=false

# ---------------------------------------------------------------------------
# Modrinth — https://modrinth.com/settings/personal-access-tokens
# Projekt muss auf Modrinth existieren (Slug oder UUID als MODRINTH_PROJECT_ID)
# ---------------------------------------------------------------------------
MODRINTH_TOKEN=
MODRINTH_PROJECT_ID=better-death-screen

# ---------------------------------------------------------------------------
# CurseForge — https://console.curseforge.com/#/api-tokens
# CURSEFORGE_PROJECT_ID = numerische Projekt-ID aus der CurseForge-URL
#   z. B. https://www.curseforge.com/minecraft/mc-mods/DEIN-MOD → ID in der API/URL
# ---------------------------------------------------------------------------
CURSEFORGE_TOKEN=
CURSEFORGE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Release-Metadaten (optional)
# ---------------------------------------------------------------------------
# STABLE | BETA | ALPHA
RELEASE_TYPE=STABLE

# Changelog-Text für den Upload (Markdown erlaubt)
CHANGELOG=Release 1.0.0

# ---------------------------------------------------------------------------
# GitHub Actions (Secrets im Repository hinterlegen, nicht in .env committen)
# ---------------------------------------------------------------------------
# MODRINTH_TOKEN
# CURSEFORGE_TOKEN
# CURSEFORGE_PROJECT_ID
# PUBLISH_ENABLED=true
